# Documentation only: staging deliberately does NOT auto-load server/.env.
SPORTSYNC_ENVIRONMENT=staging
SPORTSYNC_DEPLOYMENT_ID=pairing-stage-review
SPORTSYNC_STAGING_FRONTEND_URL=https://REPLACE-WITH-STAGING-FRONTEND.example
SPORTSYNC_DURABLE_STORAGE_ROOT=/var/data
SPORTSYNC_DB_PATH=/var/data/pairing-stage.sqlite
SPORTSYNC_DEVICE_PAIRING_ENABLED=true
SPORTSYNC_DEVICE_PAIRING_STORAGE_ACK=true
# Must be a newly generated 64-character lowercase hexadecimal secret. Do not copy production values.
SPORTSYNC_SESSION_SECRET=REPLACE_WITH_FRESH_RANDOM_64_HEX
