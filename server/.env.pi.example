SPORTSYNC_SERVER_URL=http://10.0.0.138:5000
# Optional on first boot. If omitted, a permanent UUID is generated locally.
# SPORTSYNC_DEVICE_ID=HOUSE_BOX_1
# SPORTSYNC_APPLIANCE_NAME=Venue Audio Box
# SPORTSYNC_PAIRING_CODE=BOX-EXAMPLE
SPORTSYNC_ROOM_CODE=HOME
SPORTSYNC_ROOM_NAME=Home Audio
SPORTSYNC_NOW_PLAYING=
SPORTSYNC_ROOM_ACTIVE=true
SPORTSYNC_AUDIO_ENABLED=true
SPORTSYNC_ROOM_PUBLIC=true
SPORTSYNC_AUDIO_DEVICE=auto
# Defaults to ~/.config/venue-audio/box-config.json
# SPORTSYNC_CONFIG_PATH=/home/pi-user/.config/venue-audio/box-config.json
# Set the same secret as PI_HOST_TOKEN on the backend when authentication is enabled.
# PI_HOST_TOKEN=
SPORTSYNC_RETRY_BASE_DELAY_MS=1000
SPORTSYNC_RETRY_MAX_DELAY_MS=30000
SPORTSYNC_HTTP_TIMEOUT_MS=10000
SPORTSYNC_MAX_AUDIO_CHUNK_BYTES=65536
SPORTSYNC_MAX_BUFFERED_AUDIO_BYTES=65536
